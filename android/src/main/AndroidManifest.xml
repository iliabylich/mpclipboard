<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="dev.ibylich.mpclipboard.permission.BIND_SERVICE"
        android:protectionLevel="signature" />

    <application
        android:name=".MPClipboardApplication"
        android:hasCode="true"
        android:label="@string/app_name">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MPClipboardService"
            android:exported="true"
            android:permission="dev.ibylich.mpclipboard.permission.BIND_SERVICE" />

        <receiver
            android:name=".widget.MPClipboardWidgetProvider"
            android:exported="true"
            android:label="@string/mpclipboard_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mpclipboard_widget_info" />
        </receiver>
    </application>
</manifest>
